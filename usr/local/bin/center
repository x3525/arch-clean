#!/bin/bash

execute () {
    environ=KILL=ME

    for name in $(dex --property=Name "$1"/*.desktop)
    do
        for pid in $(pgrep -f -- "$name")
        do
            if ps -p "$pid" e -ww | grep DISPLAY="$DISPLAY" | grep "$environ"
            then
                kill "$pid"

                while pgrep -p "$pid"
                do
                    sleep 1
                done
            fi
        done
    done

    env "$environ" dex --autostart --search-paths="$1"
}

iii () {
    case "$1" in
        border)
            case "$(i3-msg -t get_tree | jq --raw-output 'recurse(.nodes[],.floating_nodes[])|select(.focused)|.floating')" in
                auto_on|user_on)
                    i3-msg border "$(xrdb -get i3.default_floating_border)"
                    ;;
                *)
                    i3-msg border "$(xrdb -get i3.default_border)"
                    ;;
            esac
            ;;
    esac
}

lock () {
    dunstctl set-paused true

    i3lock --nofork --color=000000 --ignore-empty-password --show-keyboard-layout

    dunstctl set-paused false
}

menu () {
    rofi -no-lazy-grab -show combi -modes combi -theme "$1"
}

notify () {
    case "$1" in
        volume)
            case "$2" in
                inc|dec)
                    pamixer --"$2"rease="$3" --allow-boost --set-limit=150
                    ;;
                tog)
                    pamixer --toggle-mute
                    ;;
            esac

            summary=$(printf %03d "$(pamixer --get-volume)")

            if pamixer --get-mute | grep -q true
            then
                icon=audio-volume-muted
            else
                case "$summary" in
                    00[0-9])
                        icon=audio-volume-low
                        ;;
                    0[1-3][0-9])
                        icon=audio-volume-low
                        ;;
                    0[4-6][0-9])
                        icon=audio-volume-medium
                        ;;
                    0[7-9][0-9])
                        icon=audio-volume-high
                        ;;
                    1[0-2][0-9])
                        icon=audio-volume-high-warning
                        ;;
                    *)
                        icon=audio-volume-high-danger
                        ;;
                esac
            fi

            hint=(--hint=int:value:"$summary")
            ;;
    esac

    hint+=(--hint=string:x-dunst-stack-tag:"${tag:-$1}")

    notify-send --urgency="${urgency:-low}" --icon="${icon:-application-default-icon}" "${hint[@]}" "${summary:-}" "${body:-}"
}

$1 "${@:2}"
