#!/bin/bash

brightness () {
    brightnessctl s "${2:-10}"%"$1"
}

lock () {
    dunstctl set-paused true

    i3lock -nek -c 000000

    dunstctl set-paused false
}

menu () {
    stest -flx /usr/bin | sort -u | dmenu -b -i -l 5 -fn "JetBrains Mono NL-12" -nb "#000000" -nf "#F5F5DC" -sb "#2F4F4F" -sf "#000000" | sh &
}

notify () {
    case $1 in
        volume)
            if ! pactl get-default-sink
            then
                return
            fi

            until [ "$(pactl get-default-sink)" != "@DEFAULT_SINK@" ]
            do
                sleep 0.5
            done

            case $2 in
                inc|dec)
                    pamixer --"$2"rease="${3:-10}" --allow-boost --set-limit=150
                    ;;
                tog)
                    pamixer --toggle-mute
                    ;;
            esac

            summary=$(pamixer --get-volume)

            while (( ${#summary} < 3 ))
            do
                summary=0$summary
            done

            if [ "$(pamixer --get-mute)" != "false" ]
            then
                icon=audio-volume-muted
            else
                case $summary in
                    00[0-9])
                        icon=audio-volume-low
                        ;;
                    0[1-3][0-9])
                        icon=audio-volume-low
                        ;;
                    0[4-6][0-9])
                        icon=audio-volume-medium
                        ;;
                    0[7-9][0-9])
                        icon=audio-volume-high
                        ;;
                    1[0-2][0-9])
                        icon=audio-volume-high-warning
                        ;;
                    *)
                        icon=audio-volume-high-danger
                        ;;
                esac
            fi

            hint=(-h int:value:"$summary")
            ;;
        XkbLayout)
            summary=$(XkbLayout)

            if [ -z "$summary" ]
            then
                return
            fi

            icon=input-keyboard
            ;;
    esac

    hint+=(-h string:x-dunst-stack-tag:"${tag-$1}")

    notify-send -u "${urgency:-LOW}" -i "${icon:-application-default-icon}" "${hint[@]}" "${summary:-}" "${body:-}"
}

reborn () {
    searchpaths=${searchpaths:-$XDG_CONFIG_HOME/autostart/entries}

    environ=KILL=ME

    for name in $(dex -p Name "$searchpaths"/*.desktop)
    do
        for pid in $(pgrep -u $EUID -f -- "$name")
        do
            if ps -p "$pid" e -ww | grep DISPLAY="$DISPLAY" | grep "$environ"
            then
                kill "$pid"

                while pgrep -p "$pid"
                do
                    sleep 0.5
                done
            fi
        done
    done

    env "$environ" dex -a -s "$searchpaths"
}

$1 "${@:2}"
