include variables.config
include *.conf

# Control focus only by using your keyboard.
focus_follows_mouse no

# Display the popup if it belongs to the fullscreen application only.
popup_during_fullscreen smart

# The window will always be marked urgent, but the focus will not be stolen.
focus_on_window_activation urgent

# Disable tiling drag altogether.
tiling_drag off

# External locker as X screen saver.
exec --no-startup-id xss-lock -l -- center lock

# Executing applications.
exec_always --no-startup-id center execute "$XDG_CONFIG_HOME"/autostart/entries
