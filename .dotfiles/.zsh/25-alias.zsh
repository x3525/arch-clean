alias 0='xsel --clipboard --input'
alias 1='xsel --clipboard --output'
alias cal='cal --color=auto --monday'
alias cat='bat --color=auto --plain --plain --theme="Solarized (dark)"'
alias diff='diff --color=auto'
alias grep='grep --color=auto --exclude-dir={.git,.venv,venv}'
alias ls='ls --color=auto --indicator-style=classify --quoting-style=escape --time-style=iso'
alias rm='trash-put --verbose'
alias test-speaker='speaker-test --channels=2 --test=wav --nloops=1'
alias vim='vim -X'
alias which='whence -ca'
