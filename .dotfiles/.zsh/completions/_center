#compdef center

case $CURRENT in
    2)
        compadd \
            brightness \
            lock \
            menu \
            notify \
            reborn
        ;;
    3)
        case ${words[2]} in
            brightness)
                compadd \
                    + \
                    -
                ;;
            menu)
                compadd \
                    drun \
                    system
                ;;
            notify)
                compadd \
                    volume \
                    XkbLayout
                ;;
        esac
        ;;
    4)
        case ${words[2]} in
            notify)
                case ${words[3]} in
                    volume)
                        compadd \
                            inc \
                            dec \
                            tog
                        ;;
                esac
                ;;
        esac
        ;;
esac
